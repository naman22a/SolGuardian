        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "gen-env-types": "^1.3.4",
        "ioredis": "^5.7.0",
        "langchain": "^0.3.33",
        "multer": "^2.0.2",
        "prettier": "^3.6.2",
        "socket.io": "^4.8.1",
        "zod": "^4.1.5"
